rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string 
        && id.size() <= 128 
        && id.matches('^[a-zA-Z0-9_\\-:]+$'); 
    }
    
    function isValidAIExplanacao(data) {
      // Permitir múltiplos formatos de cache (Projetos, Votos, Áudio)
      return data.updatedAt != null;
    }

    match /ai_cache/{cacheId} {
      allow get: if isValidId(cacheId);
      allow list: if false; 
      allow create: if isValidId(cacheId) && isValidAIExplanacao(request.resource.data);
      allow update: if isValidId(cacheId) && isValidAIExplanacao(request.resource.data);
      allow delete: if false;
    }
  }
}
